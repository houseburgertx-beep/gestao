rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().active != false;
    }

    function userRole() {
      let r = userProfile().get('role', 'operator');
      return r in ['admin', 'administrador', 'proprietario', 'dono', 'diretoria', 'diretor', 'gestao', 'Admin', 'Administrador'] ? 'admin'
        : r in ['accountant', 'contador', 'contadora', 'financeiro', 'Financeiro', 'Contador', 'Contadora'] ? 'accountant'
        : r in ['manager', 'gerente', 'gestor', 'Gerente', 'Gestor'] ? 'manager'
        : 'operator';
    }

    function adminUser() {
      return activeUser() && userRole() == 'admin';
    }

    function directorOrAccountant() {
      return activeUser() && userRole() in ['admin', 'accountant'];
    }

    function canManageUsers() {
      return activeUser() && directorOrAccountant();
    }

    function canManageBank() {
      return activeUser() && (directorOrAccountant() || userRole() == 'manager');
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || canManageUsers();
      allow create: if canManageUsers()
        || (signedIn()
          && request.auth.uid == userId
          && request.auth.uid == "X3rPLrYN6OediKCZnn1cI8GHmVm2"
          && request.resource.data.role == "admin");
      allow update, delete: if canManageUsers();
    }

    match /employees/{documentId} {
      allow read, write: if activeUser() && directorOrAccountant();
    }

    match /suppliers/{documentId} {
      allow read, write: if activeUser() && directorOrAccountant();
    }

    match /accounts_payable/{documentId} {
      allow read, write: if activeUser() && directorOrAccountant();
    }

    match /unit_goals/{documentId} {
      allow read: if activeUser() && (directorOrAccountant() || userRole() == 'manager');
      allow write: if activeUser() && directorOrAccountant();
    }

    match /notifications/{documentId} {
      allow read, write: if activeUser();
    }

    match /daily_revenues/{documentId} {
      allow read: if activeUser() && (directorOrAccountant() || userRole() == 'manager');
      allow write: if activeUser() && directorOrAccountant();
    }

    match /documents/{documentId} {
      allow read, write: if activeUser() && directorOrAccountant();
    }

    // Source reports are shared across screens without publishing credentials.
    match /takeat_reports/{id} {
      function ownReport(data) {
        return activeUser() && data.get('tenantId', tenantId()) == tenantId()
          && (directorOrAccountant() || data.unitId == userProfile().get('unitId', ''));
      }
      function validReport(data) {
        return ownReport(data) && (directorOrAccountant() || userRole() == 'manager')
          && data.id == id && id == data.tenantId + '_' + data.unitId + '_' + data.date
          && data.updatedBy == request.auth.uid && data.source == 'takeat'
          && data.unitId in ['teixeira', 'eunapolis', 'foodpark']
          && data.totalRevenue is number && data.totalRevenue >= 0
          && data.syncedAt is string && data.date.matches('^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$')
          && data.keys().hasOnly(['id','kind','tenantId','unitId','date','source','syncedAt','totalRevenue','updatedBy','salao','delivery','ifood','rawBalcony','rawTable','rawDelivery','rawIfood']);
      }
      allow get: if activeUser() && (!exists(/databases/$(database)/documents/takeat_reports/$(id)) || ownReport(resource.data));
      allow list: if ownReport(resource.data);
      allow create: if validReport(request.resource.data);
      allow update: if ownReport(resource.data) && validReport(request.resource.data)
        && request.resource.data.syncedAt > resource.data.syncedAt;
      allow delete: if false;
    }

    // Canonical management collections are separate from the preserved legacy bases.
    function tenantId() {
      return userProfile().get('tenantId', 'house190');
    }
    function managementCollection(name) {
      return name in ['gestao_companies', 'gestao_brands', 'gestao_units',
        'gestao_categories', 'gestao_costCenters', 'gestao_suppliers',
        'gestao_bankAccounts', 'gestao_bankTransfers', 'gestao_revenues', 'gestao_sales',
        'gestao_transactions', 'gestao_payables', 'gestao_receivables',
        'gestao_taxes', 'gestao_employees', 'gestao_payroll', 'gestao_attendance',
        'gestao_products', 'gestao_purchases', 'gestao_inventory',
        'gestao_transfers', 'gestao_production', 'gestao_loans',
        'gestao_loanInstallments', 'gestao_goals', 'gestao_budgets',
        'gestao_actions', 'gestao_closings', 'gestao_cashClosings', 'gestao_cashConferences', 'gestao_coverage',
        'gestao_positions', 'gestao_policies', 'gestao_employeeVales'];
    }
    function globalCollection(name) {
      return name in ['gestao_companies', 'gestao_brands', 'gestao_units',
        'gestao_categories', 'gestao_suppliers', 'gestao_products', 'gestao_policies', 'gestao_employeeVales'];
    }
    function canReadManagement(name, data) {
      return activeUser() && data.get('tenantId', tenantId()) == tenantId()
        && (directorOrAccountant()
          || globalCollection(name)
          || name in ['gestao_bankAccounts', 'gestao_locks', 'gestao_unique']
          || (userRole() in ['manager', 'operator'] && name in ['gestao_cashClosings', 'gestao_cashConferences'])
          || (userRole() == 'manager' && name in ['gestao_actions','gestao_goals','gestao_revenues','gestao_sales','gestao_bankAccounts'])
          || (userRole() in ['manager', 'operator'] && name == 'gestao_payables'));
    }
    function operatorPixRequest(name, data) {
      return activeUser() && name == 'gestao_payables'
        && (directorOrAccountant() || userRole() in ['manager', 'operator'])
        && data.get('sourceId', '') != ''
        && data.get('paymentMethod', '') == 'PIX';
    }
    function writer(name, data) {
      return (name in ['gestao_policies', 'gestao_companies', 'gestao_brands', 'gestao_units'] ? adminUser()
        : directorOrAccountant()
          || (name in ['gestao_bankAccounts', 'gestao_bankTransfers'] && canManageBank())
          || (userRole() == 'manager' && name in ['gestao_actions', 'gestao_bankAccounts', 'gestao_bankTransfers', 'gestao_cashConferences'])
          || (userRole() in ['manager', 'operator'] && name == 'gestao_cashClosings')
          || (name == 'gestao_employeeVales' && (directorOrAccountant() || userRole() in ['manager', 'operator']))
          || (name == 'gestao_payables' && (directorOrAccountant() || userRole() in ['manager', 'operator']) && data.get('sourceId', '') != '')
          || operatorPixRequest(name, data));
    }
    function recordMonth(data) {
      return data.get('competence', '') != '' ? data.competence
        : data.get('date', '') != '' ? data.date[0:7]
        : data.get('balanceDate', '') != '' ? data.balanceDate[0:7] : '';
    }
    function openPeriod(name, data) {
      let month = recordMonth(data);
      let tid = data.get('tenantId', tenantId());
      let uid = data.get('unitId', '');
      return globalCollection(name)
        || name in ['gestao_bankAccounts', 'gestao_bankTransfers', 'gestao_closings', 'gestao_cashClosings', 'gestao_cashConferences', 'gestao_coverage', 'gestao_actions', 'gestao_employeeVales']
        || month == ''
        || uid == ''
        || !exists(/databases/$(database)/documents/gestao_locks/$(tid + '_' + uid + '_' + month))
        || get(/databases/$(database)/documents/gestao_locks/$(tid + '_' + uid + '_' + month)).data.closed != true;
    }
    function validUnit(name, data) {
      let tid = data.get('tenantId', tenantId());
      let uid = data.get('unitId', '');
      return globalCollection(name)
        || name in ['gestao_bankAccounts', 'gestao_bankTransfers', 'gestao_transactions', 'gestao_cashClosings', 'gestao_employeeVales', 'gestao_payables']
        || uid == ''
        || uid == 'matriz'
        || uid == 'all'
        || uid in ['teixeira', 'eunapolis', 'foodpark', 'central']
        || (exists(/databases/$(database)/documents/gestao_units/$(uid))
            && get(/databases/$(database)/documents/gestao_units/$(uid)).data.tenantId == tid);
    }
    function validMoney(data) {
      return !('amount' in data) || data.amount == null || (data.amount is int && data.amount >= 0);
    }
    function validManagement(name, id, data) {
      return managementCollection(name) && (canReadManagement(name, data) || operatorPixRequest(name, data)) && writer(name, data)
        && data.id == id && name == 'gestao_' + data.kind
        && data.updatedBy == request.auth.uid && data.version is int
        && validUnit(name, data) && validMoney(data) && openPeriod(name, data);
    }
    match /{name}/{id} {
      allow get: if managementCollection(name) && activeUser()
        && (!exists(/databases/$(database)/documents/$(name)/$(id)) || canReadManagement(name, resource.data));
      allow list: if managementCollection(name) && canReadManagement(name, resource.data);
      allow create: if validManagement(name, id, request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.version == 1;
      allow update: if validManagement(name, id, request.resource.data)
        && canReadManagement(name, resource.data) && openPeriod(name, resource.data)
        && request.resource.data.get('tenantId', tenantId()) == resource.data.get('tenantId', tenantId())
        && (request.resource.data.get('unitId', '') == resource.data.get('unitId', '') || name in ['gestao_bankAccounts', 'gestao_suppliers', 'gestao_cashClosings', 'gestao_employeeVales', 'gestao_payables'])
        && (request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') || !('createdBy' in resource.data) || name in ['gestao_bankAccounts', 'gestao_suppliers', 'gestao_cashClosings', 'gestao_employeeVales', 'gestao_payables'])
        && name != 'gestao_transactions'
        && (resource.data.get('settledAmount', 0) == 0 || request.resource.data.get('amount', 0) == resource.data.get('amount', 0))
        && request.resource.data.version == resource.data.get('version', 0) + 1;
      allow delete: if activeUser() && (directorOrAccountant() || userRole() in ['manager', 'operator'])
        && name == 'gestao_cashClosings'
        && resource.data.get('tenantId', tenantId()) == tenantId()
        && resource.data.get('status', '') != 'Conferido';
    }
    match /gestao_locks/{id} {
      allow get, list: if activeUser() && (!exists(/databases/$(database)/documents/gestao_locks/$(id)) || resource.data.get('tenantId', tenantId()) == tenantId());
      allow create, update: if activeUser() && directorOrAccountant()
        && request.resource.data.get('tenantId', tenantId()) == tenantId()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.closed is bool;
      allow delete: if false;
    }
    match /gestao_unique/{id} {
      allow get, list: if activeUser() && (!exists(/databases/$(database)/documents/gestao_unique/$(id)) || resource.data.get('tenantId', tenantId()) == tenantId());
      allow create, update: if activeUser() && request.resource.data.get('tenantId', tenantId()) == tenantId()
        && request.resource.data.updatedBy == request.auth.uid
        && (directorOrAccountant()
          || userRole() in ['manager', 'operator']);
      allow delete: if activeUser()
        && (directorOrAccountant()
          || userRole() in ['manager', 'operator']);
    }
    match /gestao_audit/{id} {
      allow read: if activeUser() && (directorOrAccountant()
        || userRole() in ['manager', 'operator']);
      allow create: if activeUser() && request.resource.data.get('tenantId', tenantId()) == tenantId()
        && request.resource.data.updatedBy == request.auth.uid
        && (directorOrAccountant()
          || userRole() in ['manager', 'operator']
          || canManageBank());
      allow update, delete: if false;
    }
  }
}
